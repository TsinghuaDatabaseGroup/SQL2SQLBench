    {
        "Desc": "NEXT_DAY",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "mysql"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "NEXT_DAY(<date_value: DATE>, '<format: OPTION['SUN': 'SUNDAY', 'SUNDAY', 'SAT': 'SATURDAY', 'SATURDAY', 'FRI': 'FRIDAY', 'FRIDAY', 'THU': 'THURSDAY', 'THURSDAY', 'WED': 'WEDNESDAY', 'WEDNESDAY', 'TUE': 'TUESDAY', 'TUESDAY', 'MON': 'MONDAY', 'MONDAY']>')",
        "TgtPattern": "<date_value> + CASE WHEN\n        DAYNAME(DATE_ADD(<date_value>, interval 1 day)) = '<format>' THEN 1 ELSE \n        CASE WHEN\n            DAYNAME(DATE_ADD(<date_value>, interval 2 day)) = '<format>' THEN 2 ELSE\n            CASE WHEN\n                DAYNAME(DATE_ADD(<date_value>, interval 3 day)) = '<format>' THEN 3 ELSE\n                CASE WHEN\n                    DAYNAME(DATE_ADD(<date_value>, interval 4 day)) = '<format>', 1, 3) THEN 4 ELSE\n                    CASE WHEN\n                        DAYNAME(DATE_ADD(<date_value>, interval 5 day)) = '<format>' THEN 5 ELSE\n                        CASE WHEN\n                            DAYNAME(DATE_ADD(<date_value>, interval 6 day)) = '<format>' THEN 6 ELSE \n                            CASE WHEN\n                                DAYNAME(DATE_ADD(<date_value>, interval 7 day)) = '<format>' THEN 7 ELSE NULL\n                            END\n                        END\n                    END\n                END\n            END\n        END\n    END",
        "Condition": null,
        "Return": "DATE"
    },
