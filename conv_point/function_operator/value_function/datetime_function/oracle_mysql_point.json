[
    {
        "Desc": "MONTHS_BETWEEN",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "mysql"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "MONTHS_BETWEEN(<date1: DATE>, <date2: DATE>)",
        "TgtPattern": "TIMESTAMPDIFF(month, <date2>, <date1>) + CASE WHEN DAY(<date1>) \\<\\> DAY(<date2>) AND\n        (MONTH(<date1>) = MONTH(<date1> + INTERVAL 1 DAY) OR \n         MONTH(<date2>) = MONTH(<date2> + INTERVAL 1 DAY))\n    THEN\n        CASE WHEN DAY(<date1>) \\< DAY(<date2>) THEN\n          (31 - DAY(<date2>) + DAY(<date1>)) / 31.0\n        ELSE    \n          (DAY(<date1>) - DAY(<date2>)) / 31.0\n        END\n    ELSE 0\n    END",
        "Condition": null,
        "Return": "NUMBER"
    },
