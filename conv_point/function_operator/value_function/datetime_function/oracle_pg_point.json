    {
        "Desc": "MONTHS_BETWEEN",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "pg"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "MONTHS_BETWEEN(<date1:DATE>, <date2:DATE>)",
        "TgtPattern": "EXTRACT(MONTH FROM age(<date1>, <date2>)) + \nCASE \n        WHEN <date1> \\<\\> <date2> AND \n             (EXTRACT(MONTH FROM <date1> + INTERVAL '1 day') = EXTRACT(MONTH FROM <date1>) OR\n              EXTRACT(MONTH FROM <date2> + INTERVAL '1 day') = EXTRACT(MONTH FROM <date2>))\n        THEN \n            CASE \n                WHEN <date1> \\< <date2> THEN\n                    (31 - EXTRACT(DAY FROM <date2>) + EXTRACT(DAY FROM <date1>)) / 31.0\n                ELSE \n                    (EXTRACT(DAY FROM <date1>) - EXTRACT(DAY FROM <date2>)) / 31.0\n            END\n        ELSE 0\nEND",
        "Condition": null,
        "Return": "NUMBER"
    },
