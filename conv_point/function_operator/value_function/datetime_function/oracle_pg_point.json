    {
        "Desc": "NEXT_DAY",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "pg"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "NEXT_DAY(<date_value: DATE>, '<format: OPTION['SUN':'Sunday','Sunday','SAT':'Saturday','Saturday','FRI':'Friday','Friday','THU':'Thursday','Thursday','WED':'Wednesday','Wednesday','TUE':'Tuesday','Tuesday','MON':'Monday','Monday']>')",
        "TgtPattern": "<date_value> + CASE WHEN\n        TO_CHAR(<date_value> + INTERVAL '1 day', 'Day') = <format> THEN 1 ELSE \n        CASE WHEN\n            TO_CHAR(<date_value> + INTERVAL '2 day' = <format> THEN 2 ELSE\n            CASE WHEN\n                TO_CHAR(<date_value> + INTERVAL '3 day', 'Day') = <format> THEN 4 ELSE\n                CASE WHEN\n                    TO_CHAR(<date_value> + INTERVAL '4 day', 'Day') = <format> THEN 4 ELSE\n                    CASE WHEN\n                        TO_CHAR(<date_value> + INTERVAL '5 day', 'Day' = <format> THEN 5 ELSE\n                        CASE WHEN\n                            TO_CHAR(<date_value> + INTERVAL '6 day', 'Day') = <format> THEN 6 ELSE \n                            CASE WHEN\n                                TO_CHAR(<date_value> + INTERVAL '7 day', 'Day' = <format> THEN 7 ELSE NULL\n                            END\n                        END\n                    END\n                END\n            END\n        END\n    END",
        "Condition": null,
        "Return": "DATE"
    },
