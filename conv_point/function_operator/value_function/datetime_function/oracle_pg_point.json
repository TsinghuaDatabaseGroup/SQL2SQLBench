    {
        "Desc": "ROUND_YEAR",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "pg"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "ROUND(<value:DATE>, '<options:OPTION['YEAR', 'YYYY']>')",
        "TgtPattern": "CASE WHEN EXTRACT(MONTH FROM <value>) >= 7 THEN DATE_TRUNC('YEAR', <value>) + INTERVAL '1 year' ELSE DATE_TRUNC('YEAR', <value>) END",
        "Condition": null,
