    {
        "Desc": "TO_CHAR_PARAM_GERMAN",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "snowflake"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "TO_CHAR(<date_value:DATE>)",
        "TgtPattern": "TO_CHAR(<date_value>, CONCAT(DAY(<date_value>), '-', DECODE(MONTH(<date_value>),  1, 'JAN',  2, 'FEB',  3, 'MRZ',  4, 'APR',  5, 'MAI',  6, 'JUN',  7, 'JUL',  8, 'AUG',  9, 'SEP',  10,'OKT',  11,'NOV',  12,'DEZ') , '-YY'))",
        "Condition": null,
        "Return": "STRING",
        "Tag": {
            "DB PARAMETER": {
                "oracle": {
                    "NLS_DATE_LANGUAGE": "GERMAN"
                }
            }
        }
    },
