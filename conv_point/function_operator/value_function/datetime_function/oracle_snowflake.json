[
    {
        "Desc": "ROUND_YEAR",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "snowflake"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "ROUND(<value:DATE>, '<options:OPTION['YEAR', 'YYYY']>')",
        "TgtPattern": "DATEADD(year, IFF(MONTH(<value>) >= 7, 1, 0), DATE_TRUNC('year', <value>))",
        "Condition": null,
        "Return": "DATE"
    },
    {
        "Desc": "ROUND_MONTH",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "snowflake"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "ROUND(<value:DATE>, '<options:OPTION['MONTH', 'MON']>')",
        "TgtPattern": "CASE\n    WHEN <value> IS NULL THEN NULL\n    WHEN DAY(<value>) >= 16\n      THEN DATE_TRUNC('month', DATEADD('month', 1, <value>))\n    ELSE DATE_TRUNC('month', <value>)\n  END",
        "Condition": null,
        "Return": "DATE"
    },
    {
        "Desc": "ROUND_DAY",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "snowflake"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "ROUND(<value:TIMESTAMP>, '<options:OPTION['DDD', 'DD']>')",
        "TgtPattern": "CASE WHEN HOUR(<value>) \\>= 12 THEN DATE(<value>) + INTERVAL '1 DAY' ELSE DATE(<value>) END",
        "Condition": null,
        "Return": "DATE"
    },
    {
        "Desc": "TRUNC_DEFAULT",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "snowflake"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "TRUNC(<value:TIMESTAMP>)",
        "TgtPattern": "TRUNC(<value>, 'day')",
        "Condition": null,
        "Return": "DATE"
    },
    {
