    {
        "Desc": "TRUNC_IW",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "sqlserver"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "TRUNC(<value:TIMESTAMP>, 'IW')",
        "TgtPattern": "DATEADD(day, -((DATEDIFF(day, '19000101', CAST(<value> AS date)) + 0) % 7), CAST(<value> AS date))",
        "Condition": null,
        "Return": "DATE"
