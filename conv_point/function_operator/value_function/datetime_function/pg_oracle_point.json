        "Type": "EXPRESSION",
        "SrcPattern": "EXTRACT(DECADE FROM <value: TIMESTAMP>)",
        "TgtPattern": "TRUNC(EXTRACT(YEAR FROM <value>) / 10)",
        "Condition": null,
        "Return": "NUMBER"
    },
    {
        "Desc": "EXTRACT_DOW",
        "Dialect": {
            "Src": "pg",
            "Tgt": "oracle"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "EXTRACT(DOW FROM <value: TIMESTAMP>)",
        "TgtPattern": "MOD(CAST(TO_CHAR(<value>, 'D') AS NUMBER) + 6, 7)",
        "Condition": null,
        "Return": "NUMBER"
    },
    {
        "Desc": "EXTRACT_DOY",
        "Dialect": {
            "Src": "pg",
            "Tgt": "oracle"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "EXTRACT(DOY FROM <value: TIMESTAMP>)",
        "TgtPattern": "CAST(TO_CHAR(CAST(<value> AS DATE), 'DDD') AS NUMBER)",
        "Condition": null,
        "Return": "NUMBER"
    },
    {
        "Desc": "EXTRACT_EPOCH",
        "Dialect": {
            "Src": "pg",
            "Tgt": "oracle"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "EXTRACT(EPOCH FROM <value: TIMESTAMP>)",
        "TgtPattern": "CASE WHEN <value> IS NOT NULL THEN EXTRACT(DAY FROM (<value> - TO_TIMESTAMP('1970-01-01 00:00:00', 'YYYY-MM-DD HH24:MI:SS'))) * 86400 + EXTRACT(HOUR FROM (<value> - TO_TIMESTAMP('1970-01-01 00:00:00', 'YYYY-MM-DD HH24:MI:SS'))) * 3600 + EXTRACT(MINUTE FROM (<value> - TO_TIMESTAMP('1970-01-01 00:00:00', 'YYYY-MM-DD HH24:MI:SS'))) * 60 + EXTRACT(SECOND FROM (<value> - TO_TIMESTAMP('1970-01-01 00:00:00', 'YYYY-MM-DD HH24:MI:SS'))) ELSE NULL END",
        "Condition": null,
        "Return": "NUMBER"
    },
    {
        "Desc": "TO_TIMESTAMP",
        "Dialect": {
            "Src": "pg",
            "Tgt": "oracle"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "TO_TIMESTAMP(<value: NUMBER>)",
        "TgtPattern": "CASE WHEN <value> IS NOT NULL THEN TO_TIMESTAMP('1970-01-01 00:00:00', 'YYYY-MM-DD HH24:MI:SS') + NUMTODSINTERVAL(<value>, 'SECOND') ELSE NULL END",
        "Condition": null,
        "Return": "TIMESTAMP"
    },
    {
