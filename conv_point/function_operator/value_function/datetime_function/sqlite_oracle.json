        },
        "Type": "EXPRESSION",
        "SrcPattern": "date(<date: DATE>, '+1 day')",
        "TgtPattern": "<date> + 1",
        "Condition": null,
        "Return": "DATE"
    },
    {
        "Desc": "DATETIME1",
