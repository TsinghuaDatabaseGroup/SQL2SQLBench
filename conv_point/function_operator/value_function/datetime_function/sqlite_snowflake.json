[
    {
        "Desc": "STRFTIME",
        "Dialect": {
            "Src": "sqlite",
            "Tgt": "snowflake"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "STRFTIME('%Y', <value: DATE>)",
        "TgtPattern": "TO_CHAR(TO_DATE(<value>), 'YYYY')",
        "Condition": null,
        "Return": "STRING",
        "Demo": {
            "sqlite": "SELECT STRFTIME('%Y', '2024-06-01');",
            "snowflake": "SELECT TO_CHAR(TO_DATE('2024-06-01'), 'YYYY');"
        }
    },
