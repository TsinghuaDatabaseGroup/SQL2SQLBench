    {
        "Desc": "FROM_UNIXTIME1",
        "Dialect": {
            "Src": "sqlite",
            "Tgt": "sqlserver"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "UNIXEPOCH(<value: TIMESTAMP>)",
        "TgtPattern": "DATEDIFF(SECOND, '1970-01-01 00:00:00', <value>)",
        "Condition": null,
        "Return": "INT",
        "Demo": {
            "sqlite": "SELECT UNIXEPOCH('1970-01-02 00:00:00');",
            "sqlserver": "SELECT DATEDIFF(SECOND, CAST('1970-01-01 00:00:00' AS DATETIME2), CAST('1970-01-02 00:00:00' AS DATETIME2));"
        }
    },
    {
        "Desc": "FROM_UNIXTIME2",
        "Dialect": {
            "Src": "sqlite",
            "Tgt": "sqlserver"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "DATETIME(<value: NUMBER>, 'unixepoch')",
        "TgtPattern": "DATEADD(SECOND, <value>, CAST('1970-01-01 00:00:00' AS DATETIME2))",
        "Condition": null,
        "Return": "DATE",
        "Demo": {
            "sqlite": "SELECT DATETIME(86400, 'unixepoch');",
            "sqlserver": "SELECT DATEADD(SECOND, 86400, CAST('1970-01-01 00:00:00' AS DATETIME2));"
        }
    },
    {
        "Desc": "DATE_ADD1",
        "Dialect": {
            "Src": "sqlite",
            "Tgt": "sqlserver"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "date(<date: DATE>, '+1 day', 'start of month')",
        "TgtPattern": "DATEFROMPARTS(YEAR(DATEADD(DAY, 1, <date>)), MONTH(DATEADD(DAY, 1, <date>)), 1)",
        "Condition": null,
        "Return": "DATE",
        "Demo": {
            "sqlite": "SELECT DATE('2024-08-31', '+1 day', 'start of month');",
            "sqlserver": "SELECT DATEFROMPARTS(YEAR(DATEADD(DAY, 1, CAST('2024-08-31' AS DATE))), MONTH(DATEADD(DAY, 1, CAST('2024-08-31' AS DATE))), 1);"
        }
    },
