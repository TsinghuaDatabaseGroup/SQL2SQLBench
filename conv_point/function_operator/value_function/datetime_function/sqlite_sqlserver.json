    {
        "Desc": "JULIANDAY",
        "Dialect": {
            "Src": "sqlite",
            "Tgt": "sqlserver"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "JULIANDAY(<date1: DATE>) - JULIANDAY(<date2: DATE>)",
        "TgtPattern": "DATEDIFF(DAY, <date2>, <date1>)",
        "Condition": null,
        "Return": "INT",
        "Demo": {
            "sqlite": "SELECT JULIANDAY('2024-08-15') - JULIANDAY('2024-08-10');",
            "sqlserver": "SELECT DATEDIFF(DAY, CAST('2024-08-10' AS DATE), CAST('2024-08-15' AS DATE));"
        }
    }
