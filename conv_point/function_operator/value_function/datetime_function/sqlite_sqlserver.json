[
    {
        "Desc": "STRFTIME",
        "Dialect": {
            "Src": "sqlite",
            "Tgt": "sqlserver"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "STRFTIME('%Y', <value: DATE>)",
        "TgtPattern": "CAST(DATEPART(YEAR, <value>) AS VARCHAR(4))",
        "Condition": null,
        "Return": "STRING",
        "Demo": {
            "sqlite": "SELECT STRFTIME('%Y', '2024-08-15');",
            "sqlserver": "SELECT CAST(DATEPART(YEAR, CAST('2024-08-15' AS DATE)) AS VARCHAR(4));"
        }
    },
    {
        "Desc": "STRFTIME2",
        "Dialect": {
            "Src": "sqlite",
            "Tgt": "sqlserver"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "STRFTIME('%Y', 'now')",
        "TgtPattern": "CAST(DATEPART(YEAR, GETUTCDATE()) AS VARCHAR(4))",
        "Condition": null,
        "Return": "STRING",
        "Demo": {
            "sqlite": "SELECT STRFTIME('%Y', 'now');",
            "sqlserver": "SELECT CAST(DATEPART(YEAR, GETUTCDATE()) AS VARCHAR(4));"
        }
    },
    {
        "Desc": "STRFTIME3",
        "Dialect": {
            "Src": "sqlite",
            "Tgt": "sqlserver"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "strftime('%Y-%m-%d %H:%M:%S', <date: TIMESTAMP, STRICT>, '+3 hours')",
        "TgtPattern": "CONVERT(VARCHAR(19), DATEADD(HOUR, 3, <date>), 120)",
        "Condition": null,
        "Return": "STRING",
        "Demo": {
            "sqlite": "SELECT STRFTIME('%Y-%m-%d %H:%M:%S', '2024-08-15 10:20:30', '+3 hours');",
            "sqlserver": "SELECT CONVERT(VARCHAR(19), DATEADD(HOUR, 3, CAST('2024-08-15 10:20:30' AS DATETIME2)), 120);"
        }
    },
