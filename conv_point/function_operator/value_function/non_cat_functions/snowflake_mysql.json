    {
        "Desc": "COVAR_POP",
        "Dialect": {
            "Src": "snowflake",
            "Tgt": "mysql"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "COVAR_POP(<x: NUMBER>, <y: NUMBER>)",
        "TgtPattern": "(SUM(CASE WHEN <x> + <y> IS NOT NULL THEN <x>*<y> END)\n  -\n  SUM(CASE WHEN <x> + <y> IS NOT NULL THEN <x> END)\n  *\n  SUM(CASE WHEN <x> + <y> IS NOT NULL THEN <y> END)\n  /\n  NULLIF(SUM(CASE WHEN <x> + <y> IS NOT NULL THEN 1 END), 0)\n)\n/\nNULLIF(SUM(CASE WHEN <x> + <y> IS NOT NULL THEN 1 END), 0)",
        "Condition": null,
        "Return": "NUMBER"
    },
