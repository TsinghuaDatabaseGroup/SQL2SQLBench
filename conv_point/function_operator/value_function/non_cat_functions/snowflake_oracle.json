    {
        "Desc": "STARTSWITH",
        "Dialect": {
            "Src": "snowflake",
            "Tgt": "oracle"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "STARTSWITH(<str: STRING>, <prefix: STRING>)",
        "TgtPattern": "CASE WHEN SUBSTR(<str>, 1, LENGTH(<prefix>)) = <prefix> THEN 1 ELSE 0 END",
        "Condition": null,
        "Return": "NUMBER",
        "Demo": {
            "snowflake": "SELECT STARTSWITH('abcdef', 'abc');",
            "oracle": "SELECT CASE WHEN SUBSTR('abcdef', 1, LENGTH('abc')) = 'abc' THEN 1 ELSE 0 END;"
        }
    },
