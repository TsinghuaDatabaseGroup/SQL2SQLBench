[
    {
        "Desc": "ADD_MONTHS",
        "Dialect": {
            "Src": "snowflake",
            "Tgt": "pg"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "ADD_MONTHS(<value: DATE>, <n: INT>)",
        "TgtPattern": "CAST(<value> + (<n> * INTERVAL '1 month') AS DATE)",
        "Condition": null,
        "Return": "DATE",
        "Demo": {
            "snowflake": "SELECT ADD_MONTHS(TO_DATE('2024-05-17'), 2);",
            "pg": "SELECT CAST(CAST('2024-05-17' AS DATE) + (2 * INTERVAL '1 month') AS DATE);"
        }
    },
