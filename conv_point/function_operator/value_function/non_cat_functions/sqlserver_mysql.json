            "Src": "sqlserver",
            "Tgt": "mysql"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "ISNULL(<expr: ANY_VALUE>, <replacement: ANY_VALUE>)",
        "TgtPattern": "IFNULL(<expr>, <replacement>)",
