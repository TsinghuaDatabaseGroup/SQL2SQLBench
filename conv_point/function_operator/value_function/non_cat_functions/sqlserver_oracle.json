    {
        "Desc": "DATEDIFF_MONTH_TO_TIMESTAMPDIFF_MONTH",
        "Dialect": {
            "Src": "sqlserver",
            "Tgt": "oracle"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "DATEDIFF(month, <start: DATE>, <end: DATE>)",
        "TgtPattern": "((EXTRACT(YEAR FROM <end>) - EXTRACT(YEAR FROM <start>)) * 12 + (EXTRACT(MONTH FROM <end>) - EXTRACT(MONTH FROM <start>)))",
        "Condition": null,
        "Return": "INT",
        "Demo": {
            "sqlserver": "SELECT DATEDIFF(month, CAST('2024-01-01' AS date), CAST('2024-05-01' AS date)) AS diff_months;",
            "oracle": "SELECT ((EXTRACT(YEAR FROM DATE '2024-05-01') - EXTRACT(YEAR FROM DATE '2024-01-01')) * 12 + (EXTRACT(MONTH FROM DATE '2024-05-01') - EXTRACT(MONTH FROM DATE '2024-01-01'))) AS diff_months FROM dual;"
        }
    },
