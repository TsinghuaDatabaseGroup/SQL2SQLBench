    {
        "Desc": "DATEDIFF_DAY_TO_DATE_SUBTRACT",
        "Dialect": {
            "Src": "sqlserver",
            "Tgt": "pg"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "DATEDIFF(day, <start: DATE>, <end: DATE>)",
        "TgtPattern": "(<end> - <start>)",
        "Condition": null,
        "Return": "INT",
        "Demo": {
            "sqlserver": "SELECT DATEDIFF(day, CAST('2024-05-01' AS date), CAST('2024-05-06' AS date)) AS diff_days;",
            "pg": "SELECT (DATE '2024-05-06' - DATE '2024-05-01') AS diff_days;"
        }
    },
    {
        "Desc": "DATEDIFF_MONTH_TO_MONTH_BOUNDARY_DIFF",
        "Dialect": {
            "Src": "sqlserver",
            "Tgt": "pg"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "DATEDIFF(month, <start: DATE>, <end: DATE>)",
        "TgtPattern": "(((EXTRACT(YEAR FROM <end>) - EXTRACT(YEAR FROM <start>)) * 12) + (EXTRACT(MONTH FROM <end>) - EXTRACT(MONTH FROM <start>)))::INT",
        "Condition": null,
        "Return": "INT",
        "Demo": {
            "sqlserver": "SELECT DATEDIFF(month, CAST('2024-01-01' AS date), CAST('2024-05-01' AS date)) AS diff_months;",
            "pg": "SELECT (((EXTRACT(YEAR FROM DATE '2024-05-01') - EXTRACT(YEAR FROM DATE '2024-01-01')) * 12) + (EXTRACT(MONTH FROM DATE '2024-05-01') - EXTRACT(MONTH FROM DATE '2024-01-01')))::INT AS diff_months;"
        }
    },
