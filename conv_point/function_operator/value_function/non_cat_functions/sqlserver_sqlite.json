    {
        "Desc": "DATEDIFF_DAY_TO_DATEDIFF",
        "Dialect": {
            "Src": "sqlserver",
            "Tgt": "sqlite"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "DATEDIFF(day, <start: DATE>, <end: DATE>)",
        "TgtPattern": "CAST(julianday(date(<end>)) - julianday(date(<start>)) AS INTEGER)",
        "Condition": null,
        "Return": "NUMBER",
        "Demo": {
            "sqlserver": "SELECT DATEDIFF(day, CAST('2024-05-01' AS date), CAST('2024-05-06' AS date)) AS diff_days;",
            "sqlite": "SELECT CAST(julianday(date('2024-05-06')) - julianday(date('2024-05-01')) AS INTEGER) AS diff_days;"
        }
