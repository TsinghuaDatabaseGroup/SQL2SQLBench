    {
        "Desc": "DATEDIFF_MONTH_TO_TIMESTAMPDIFF_MONTH",
        "Dialect": {
            "Src": "sqlserver",
            "Tgt": "sqlite"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "DATEDIFF(month, <start: DATE>, <end: DATE>)",
        "TgtPattern": "((CAST(strftime('%Y', <end>) AS INTEGER) - CAST(strftime('%Y', <start>) AS INTEGER)) * 12 + (CAST(strftime('%m', <end>) AS INTEGER) - CAST(strftime('%m', <start>) AS INTEGER)))",
        "Condition": null,
        "Return": "INT",
        "Demo": {
            "sqlserver": "SELECT DATEDIFF(month, CAST('2024-01-01' AS date), CAST('2024-05-01' AS date)) AS diff_months;",
            "sqlite": "SELECT ((CAST(strftime('%Y', '2024-05-01') AS INTEGER) - CAST(strftime('%Y', '2024-01-01') AS INTEGER)) * 12 + (CAST(strftime('%m', '2024-05-01') AS INTEGER) - CAST(strftime('%m', '2024-01-01') AS INTEGER))) AS diff_months;"
        }
    },
