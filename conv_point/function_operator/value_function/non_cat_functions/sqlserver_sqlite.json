    {
        "Desc": "STDEV_TO_STDDEV_SAMP",
        "Dialect": {
            "Src": "sqlserver",
            "Tgt": "sqlite"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "STDEV(<col: DOUBLE>)",
        "TgtPattern": "SQRT((SUM(<col> * <col>) - SUM(<col>) * SUM(<col>) * 1.0 / COUNT(<col>)) / (COUNT(<col>) - 1))",
        "Condition": null,
        "Return": "DOUBLE",
        "Demo": {
            "sqlserver": "SELECT STDEV(val) AS result FROM (VALUES (1.0), (3.0), (5.0)) AS t(val);",
            "sqlite": "SELECT SQRT((SUM(val * val) - SUM(val) * SUM(val) * 1.0 / COUNT(val)) / (COUNT(val) - 1)) AS result FROM (VALUES (1.0), (3.0), (5.0)) AS t(val);"
        }
    },
