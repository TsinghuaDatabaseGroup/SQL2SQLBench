    {
        "Desc": "WIDTH_BUCKET",
        "Dialect": {
            "Src": "oracle",
            "Tgt": "mysql"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "CASE WHEN <num: INT> IS NOT NULL THEN WIDTH_BUCKET(NVL(<num>,0), <low: INT, LITERAL>, <low> + <val: INT, LITERAL, [5, 30)>, <num_buckets: INT, LITERAL, [5, 15]>) ELSE NULL END",
        "TgtPattern": "CASE WHEN <num> IS NOT NULL THEN CASE WHEN <num> \\< <low> THEN 0 WHEN <num> \\>= <low> + <val> THEN <num_buckets> + 1 ELSE FLOOR((<num> - <low>) / ((<val> * 1.0) / <num_buckets>)) + 1 END ELSE NULL END",
        "Condition": null,
        "Return": "INT"
    },
