        "Desc": "WIDTH_BUCKET",
        "Dialect": {
            "Src": "pg",
            "Tgt": "mysql"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "WIDTH_BUCKET(<num: INT>, <low: INT, LITERAL>, <low> + <val: INT, LITERAL, [5, 30)>, <num_buckets: INT, LITERAL, [5, 15]>)",
