        "Desc": "SPHERE_DISTANCE",
        "Dialect": {
            "Src": "pg",
            "Tgt": "oracle"
        },
        "Type": "EXPRESSION",
        "SrcPattern": "ST_DistanceSphere(<point1: POINT>, <point2: POINT>)",
        "TgtPattern": "6371000 * 2 * ASIN(SQRT(POWER(SIN((<point2>.SDO_POINT.Y - <point1>.SDO_POINT.Y) * ACOS(-1) / 180 / 2), 2) + COS(<point1>.SDO_POINT.Y * ACOS(-1) / 180) * COS(<point2>.SDO_POINT.Y * ACOS(-1) / 180) * POWER(SIN((<point2>.SDO_POINT.X - <point1>.SDO_POINT.X) * ACOS(-1) / 180 / 2), 2)))",
        "Condition": null,
        "Return": "NUMBER"
    },
