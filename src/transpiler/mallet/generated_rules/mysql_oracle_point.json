  {
    "Desc": "Convert MySQL TRIM with multiple characters to Oracle compatible form. Oracle TRIM only allows single-character sets, so we use REGEXP_REPLACE for multi-character sets.",
    "Type": "EXPRESSION",
    "Dialect": {
      "Src": "mysql",
      "Tgt": "oracle"
    },
    "SrcPattern": "TRIM( BOTH <set:STRING> FROM <expr:ANY_VALUE> )",
    "TgtPattern": "CASE WHEN LENGTH(<set>) = 1 THEN TRIM(BOTH <set> FROM <expr>) ELSE REGEXP_REPLACE(<expr>, '^[' || <set> || ']+|[' || <set> || ']+$', '') END",
    "Condition": null,
    "Return": "ANY_VALUE",
    "Tag": {
      "DB PARAMETER": {
        "mysql": {},
        "oracle": {}
      }
    }
  },
  {
    "Desc": "Convert MySQL TRIM function with multi-character LEADING clause to Oracle-compatible pattern. MySQL allows multi-character removal sets while Oracle requires single-character sets. This rule handles multi-character cases using REGEXP_REPLACE with proper escaping.",
    "Type": "EXPRESSION",
    "Dialect": {
      "Src": "mysql",
      "Tgt": "oracle"
    },
    "SrcPattern": "TRIM ( LEADING <remstr: STRING> FROM <str: ANY_VALUE> )",
    "TgtPattern": "REGEXP_REPLACE ( <str> , '^[' || REPLACE(REPLACE(REPLACE(<remstr>, '\\\\', '\\\\\\\\'), ']', '\\\\]'), '-', '\\\\-') || ']+' , '' )",
    "Condition": null,
    "Return": "ANY_VALUE",
    "Tag": {
      "DB PARAMETER": {
        "mysql": {},
        "oracle": {}
      }
    }
