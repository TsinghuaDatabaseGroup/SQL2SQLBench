  {
    "Desc": "In MySQL, AVG can implicitly convert string values to numbers during aggregation, while PostgreSQL requires explicit casting for non-numeric types. This rule adds a CAST to DOUBLE PRECISION to preserve MySQL's numeric aggregation behavior.",
    "Type": "EXPRESSION",
    "Dialect": {
      "Src": "mysql",
      "Tgt": "pg"
    },
    "SrcPattern": "AVG ( <expr: ANY_VALUE> )",
    "TgtPattern": "AVG ( CAST ( <expr> AS DOUBLE PRECISION ) )",
    "Condition": null,
    "Return": "ANY_VALUE",
    "Tag": {
      "DB PARAMETER": {
        "mysql": {},
        "pg": {}
      }
    }
  },
