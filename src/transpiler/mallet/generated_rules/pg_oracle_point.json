    "Desc": "Convert PostgreSQL TRIM(BOTH ...) to Oracle equivalent using nested RTRIM and LTRIM since Oracle TRIM only supports single-character sets",
    "Type": "EXPRESSION",
    "Dialect": {
      "Src": "pg",
      "Tgt": "oracle"
    },
    "SrcPattern": "TRIM ( BOTH <trim_set: ANY_VALUE> FROM <expr: ANY_VALUE> )",
    "TgtPattern": "RTRIM ( LTRIM ( <expr> , <trim_set> ) , <trim_set> )",
    "Condition": null,
    "Return": "ANY_VALUE",
    "Tag": {
      "DB PARAMETER": {
        "pg": {},
        "oracle": {}
      }
    }
  },
  {
    "Desc": "Convert PostgreSQL TRIM(LEADING <multi-char> FROM ...) to Oracle-compatible equivalent. Oracle's TRIM only allows single-character trim sets, so we conditionally use native TRIM for single-character strings and REGEXP_REPLACE for multi-character strings to remove only the first occurrence.",
    "Type": "EXPRESSION",
    "Dialect": {
      "Src": "pg",
      "Tgt": "oracle"
    },
    "SrcPattern": "TRIM ( LEADING <trim_str: STRING> FROM <source: ANY_VALUE> )",
    "TgtPattern": "CASE WHEN LENGTH ( <trim_str> ) = 1 THEN TRIM ( LEADING <trim_str> FROM <source> ) ELSE REGEXP_REPLACE ( <source> , '^' || <trim_str> , '' ) END",
    "Condition": null,
    "Return": "ANY_VALUE",
    "Tag": {
      "DB PARAMETER": {
        "pg": {},
        "oracle": {}
      }
    }
  },
